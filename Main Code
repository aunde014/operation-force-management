<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Operation Force Management</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #1a1a1a;
            color: white;
            text-align: center;
            padding: 50px;
        }

        .card {
            max-width: 800px;
            margin: auto;
            background: #2c2c2c;
            padding: 20px;
            border-radius: 10px;
        }

        button {
            display: block;
            width: 100%;
            margin: 10px 0;
            padding: 15px;
            font-size: 16px;
            cursor: pointer;
        }

        #result {
            margin-top: 20px;
            font-size: 20px;
            font-weight: bold;
        }

        #xp {
            color: gold;
            font-size: 24px;
        }
    </style>
</head>
<body>

<div class="card">
    <h1>🛡️ Operation Force Management</h1>
    <h2>Rank: MAJ</h2>

    <p>XP: <span id="xp">0</span></p>

    <h3>Question 1</h3>

    <p>
        Which Continuous Transformation horizon focuses
        on immediate requirements?
    </p>

    <button onclick="correct()">
        Transformation in Contact
    </button>

    <button onclick="wrong()">
        Deliberate Transformation
    </button>

    <button onclick="wrong()">
        Concept-Driven Transformation
    </button>

    <button onclick="wrong()">
        Capability Portfolio Management
    </button>

    <div id="result"></div>
</div>

<script>
let xp = 0;

function correct() {
    xp += 50;
    document.getElementById("xp").textContent = xp;

    document.getElementById("result").innerHTML =
        "✅ Correct! +50 XP";
}

function wrong() {
    document.getElementById("result").innerHTML =
        "❌ Incorrect. Try Again.";
}
</script>

</body>
</html>
